{
  "extends": [
    "github>1stG/configs"
  ],
  "packageRules": [
    {
      "description": "Approve the napi-rs WASI runtime and emnapi as one unit: the runtime bundles the emnapi plugin at build time, so the pair must move together.",
      "matchPackageNames": [
        "@napi-rs/wasm-runtime",
        "@emnapi/core",
        "@emnapi/runtime",
        "emnapi"
      ],
      "groupName": "napi-rs wasm toolchain",
      "dependencyDashboardApproval": true
    }
  ]
}
