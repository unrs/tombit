{
  "extends": [
    "github>1stG/configs"
  ],
  "packageRules": [
    {
      "description": "Review @napi-rs/wasm-runtime updates from the Dependency Dashboard: the runtime bundles the emnapi plugin at build time and follows its own release channel.",
      "matchPackageNames": [
        "@napi-rs/wasm-runtime"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Follow the emnapi alpha channel: @napi-rs/wasm-runtime 1.2.5 bundles the 2.0.0-alpha plugin and breaks on the beta rename.",
      "matchPackageNames": [
        "@emnapi/core",
        "@emnapi/runtime",
        "emnapi"
      ],
      "followTag": "alpha"
    }
  ]
}
