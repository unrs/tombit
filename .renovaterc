{
  "extends": [
    "github>1stG/configs"
  ],
  "packageRules": [
    {
      "description": "Review the napi-rs WASI runtime and emnapi as one unit; the runtime bundles the emnapi plugin at build time.",
      "matchPackageNames": [
        "@napi-rs/wasm-runtime",
        "@emnapi/core",
        "@emnapi/runtime",
        "emnapi"
      ],
      "groupName": "napi-rs wasm toolchain",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Follow the emnapi alpha channel: @napi-rs/wasm-runtime 1.2.5 bundles the 2.0.0-alpha plugin and breaks on the beta rename.",
      "matchPackageNames": [
        "@emnapi/core",
        "@emnapi/runtime",
        "emnapi"
      ],
      "followTag": "alpha"
    }
  ]
}
