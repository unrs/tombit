{
  "name": "tombit",
  "version": "0.1.0",
  "description": "Unified toolkit for tombi: format, lint and serialize TOML from Node.js and WebAssembly",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unrs/tombit.git"
  },
  "keywords": [
    "tombit",
    "tombi",
    "toml",
    "formatter",
    "linter",
    "parser",
    "napi",
    "napi-rs",
    "rust",
    "wasm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "napi": {
    "binaryName": "tombit",
    "packageName": "@tombit/binding",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ],
    "rootPublisher": "pnpm"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "test": "pnpm run build:debug && vitest run",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "test:rust": "cargo test",
    "test:watch": "pnpm run build:debug && vitest",
    "version": "changeset version && cargo set-version --workspace \"$(node -p 'require(\"./package.json\").version')\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "^1.2.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@napi-rs/cli": "^3.10.8",
    "emnapi": "1.11.2",
    "lefthook": "^2.2.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
